{
  "name": "pi-sidebar",
  "version": "0.1.0",
  "description": "OpenCode-style right sidebar overlay for Pi coding agent with session info, context tokens, cost, LSP status, and project details.",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "license": "MIT",
  "author": "mastnacek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastnacek/pi-sidebar.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "sidebar",
    "opencode",
    "tui",
    "overlay"
  ],
  "files": [
    "src",
    "index.ts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsc && node --test dist/test/**/*.test.js"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.13.0",
    "typebox": "^1.3.19",
    "typescript": "^5.8.0"
  }
}
